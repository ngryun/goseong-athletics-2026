rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // 처음 관리자. 다른 관리자는 관리자 화면에서 admins/{이메일} 문서로 추가합니다.
    function isOwner() {
      return signedIn() && request.auth.token.email == 'ngryun@gmail.com';
    }
    function isAdmin() {
      return isOwner() ||
        (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    // 경기 결과 한 문서: 누구나 읽고, 관리자만 씁니다.
    match /meet/results {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['r', 'updatedAt']);
    }
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
  }
}
